<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/keywordsPanel"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_custom_modal_bottom"
    android:clipToOutline="true"
    android:elevation="0dp"
    android:orientation="vertical"
    android:clickable="true"
    android:focusable="true">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.core.widget.NestedScrollView
            android:id="@+id/keywordsScrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <include layout="@layout/content_keywords" />
        </androidx.core.widget.NestedScrollView>

    </FrameLayout>

    <!-- Universal Handle at the bottom of top sheet -->
    <include
        layout="@layout/view_panel_handle"
        android:id="@+id/keywordsHandle" />
</LinearLayout>
