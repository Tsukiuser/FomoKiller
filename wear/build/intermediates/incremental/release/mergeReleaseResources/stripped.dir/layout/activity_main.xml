<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/wheelContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">


        <!-- Card 0: Désactivé (OFF) -->
        <FrameLayout
            android:id="@+id/cardOff"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_card_active"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/centerAnchor"
            app:layout_constraintWidth_percent="0.86">

            <TextView
                android:id="@+id/titleOff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/mode_off"
                android:textColor="@color/card_title_active"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Card 1: Activé (KILL_ALL) -->
        <FrameLayout
            android:id="@+id/cardKillAll"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_card_inactive"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/centerAnchor"
            app:layout_constraintWidth_percent="0.86">

            <TextView
                android:id="@+id/titleKillAll"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/mode_kill_all"
                android:textColor="@color/card_title_inactive"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Card 2: Protégé (VIP_ONLY) -->
        <FrameLayout
            android:id="@+id/cardVipOnly"
            android:layout_width="0dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_card_inactive"
            android:clickable="true"
            android:focusable="true"
            app:layout_constraintBottom_toTopOf="@id/centerAnchor"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@id/centerAnchor"
            app:layout_constraintWidth_percent="0.86">

            <TextView
                android:id="@+id/titleVipOnly"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/mode_vip_only"
                android:textColor="@color/card_title_inactive"
                android:textSize="22sp"
                android:textStyle="bold" />
        </FrameLayout>

        <!-- Center Anchor line (50% vertically) -->
        <View
            android:id="@+id/centerAnchor"
            android:layout_width="1dp"
            android:layout_height="1dp"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.45" />

        <!-- Scrim gradient behind subtext: 0% black (top) to 50% black (bottom) -->
        <View
            android:id="@+id/subtextScrim"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:background="@drawable/bg_subtext_scrim"
            app:layout_constraintTop_toTopOf="@id/textSubtext"
            app:layout_constraintBottom_toBottomOf="parent" />

        <!-- Description Subtext for Focused Button -->
        <TextView
            android:id="@+id/textSubtext"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="@string/desc_off"
            android:textColor="@color/subtext_gray"
            android:textSize="13sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/cardOff"
            app:layout_constraintWidth_percent="0.90" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
